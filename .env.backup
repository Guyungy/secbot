# Secbot 环境变量模板
# 使用方式：
# 1. 复制本文件为 .env
# 2. 选择一种推理后端：DeepSeek（云端）或 Ollama（本地）
# 3. 默认仅监听本机 127.0.0.1，更适合安全试运行

# ------------------------------------------------------------------------------
# 服务启动安全默认值
# ------------------------------------------------------------------------------
SECBOT_SERVER_HOST=127.0.0.1
SECBOT_SERVER_PORT=8000
SECBOT_SERVER_RELOAD=false
SECBOT_DESKTOP=1

# ------------------------------------------------------------------------------
# 数据与日志
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/secbot.db
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
# 初始化时是否在控制台显示详细日志（默认 false 折叠初始化日志）
VERBOSE_INIT=false

# ------------------------------------------------------------------------------
# 推理后端：二选一
# 可选值：ollama | deepseek
# 建议安全试运行优先使用本地 Ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 方案一：Ollama（本地）
# 当 LLM_PROVIDER=ollama 时使用
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.7
# 当前模型是否支持工具/function calling。gemma3:1b 等不支持时设为 false
LLM_TOOLS_SUPPORTED=true

# ------------------------------------------------------------------------------
# 方案二：DeepSeek（云端）
# 当 LLM_PROVIDER=deepseek 时使用
# 获取 API Key: https://platform.deepseek.com
# ------------------------------------------------------------------------------
# DEEPSEEK_API_KEY=你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 聊天模式：deepseek-chat | 推理模式：deepseek-reasoner
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 可选外部能力
# 不需要时请留空
# ------------------------------------------------------------------------------
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
